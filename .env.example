# Copy this file to .env and fill in your key
# Get an API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# The model to use
DEFAULT_MODEL=
# Set this to the exact group name (subject) you want the bot to listen to.
TARGET_GROUP_NAME=my group name
# Direct court booking user LIDs (comma-separated). If any of these users appear in a court booking, it is treated as a prebooked court.
DIRECT_COURT_BOOKING_USER_LIDS=
# Court numbers to ignore from match polls and court availability (comma-separated, e.g. 4 or 4, 5)
IGNORED_COURTS=4
