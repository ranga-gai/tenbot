# Copy this file to .env and fill in your key
# Get an API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# The model to use
DEFAULT_MODEL=
# Court numbers to ignore from match polls and court availability (comma-separated, e.g. 4 or 4, 5)
IGNORED_COURTS=4
# WhatsApp LID or Phone number JID of the bot superadmin. Group configuration commands are restricted to superadmin via DM.
SUPERADMIN_ACCOUNT=