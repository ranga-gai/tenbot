# Copy this file to .env and fill in your key
# Get an API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# The model to use
DEFAULT_MODEL=
# WhatsApp LID or Phone number JID of the bot superadmin. Group configuration commands are restricted to superadmin via DM.
SUPERADMIN_ACCOUNT=
# Note: Court venue credentials and settings are configured in config/courts.json (see config/courts.json.example).

# Configuration and data directories (relative to top level app folder, or absolute)
# Defaults to 'config' and 'data' if omitted
CONFIG_DIR=config
DATA_DIR=data
